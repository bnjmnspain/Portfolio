# GitHub username to pull repos/profile data for (public API, no token required for low volume).
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# Optional: raises GitHub API rate limits from 60/hr to 5000/hr. Create at
# https://github.com/settings/tokens (no scopes needed for public data).
# Server-side only — never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=

# Optional: site URL used for metadata, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional analytics (Plausible, Vercel Analytics, etc.) — wire up in app/layout.tsx.
NEXT_PUBLIC_ANALYTICS_ID=
